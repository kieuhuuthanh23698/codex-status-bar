<Window x:Class="CodexStatusBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Status Bar Settings" Icon="/CodexStatusBar;component/Assets/CodexStatusBar.ico" Width="570" Height="700" MinHeight="580"
        Background="#FF111827" Foreground="#FFF3F4F6" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF3F4F6" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFF3F4F6"/><Setter Property="Margin" Value="0,4"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#FF293244"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF4B5563"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4"/></Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save settings" Click="Save_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,6"/>
        <WrapPanel><CheckBox x:Name="StartWindows" Content="Start with Windows"/><CheckBox x:Name="ShowTray" Content="Show tray icon" Margin="20,4,0,4"/><CheckBox x:Name="ShowBar" Content="Show floating status bar" Margin="20,4,0,4"/></WrapPanel>
        <WrapPanel><CheckBox x:Name="AlwaysTop" Content="Always on top"/><CheckBox x:Name="HideFullscreen" Content="Hide when fullscreen" Margin="20,4,0,4"/><CheckBox x:Name="LockDefault" Content="Lock new bars by default" Margin="20,4,0,4"/></WrapPanel>
        <TextBlock Text="Refresh interval" Foreground="#FF9CA3AF" Margin="0,9,0,4"/>
        <ComboBox x:Name="RefreshInterval" Width="180" HorizontalAlignment="Left">
          <ComboBoxItem Content="15 seconds" Tag="15"/><ComboBoxItem Content="30 seconds" Tag="30"/><ComboBoxItem Content="60 seconds" Tag="60"/><ComboBoxItem Content="2 minutes" Tag="120"/><ComboBoxItem Content="5 minutes" Tag="300"/>
        </ComboBox>
        <Separator Margin="0,15" Background="#FF374151"/>
        <TextBlock Text="Display" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,6"/>
        <WrapPanel><CheckBox x:Name="AllMonitors" Content="Show on all monitors"/><TextBlock Text="  Otherwise choose one or more monitors below." Foreground="#FF9CA3AF" VerticalAlignment="Center"/></WrapPanel>
        <ListBox x:Name="MonitorsList" Height="115" Background="#FF1F2937" Foreground="#FFF3F4F6" BorderBrush="#FF374151">
          <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="#FFF3F4F6"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Margin="0,9,0,0">
          <TextBlock Text="Mode" Foreground="#FF9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="DisplayMode" Width="125"><ComboBoxItem Content="Compact"/><ComboBoxItem Content="Full"/><ComboBoxItem Content="Minimal"/></ComboBox>
          <TextBlock Text="Position" Foreground="#FF9CA3AF" VerticalAlignment="Center" Margin="18,0,8,0"/>
          <ComboBox x:Name="Position" Width="150"><ComboBoxItem Content="Top Left"/><ComboBoxItem Content="Top Center"/><ComboBoxItem Content="Top Right"/><ComboBoxItem Content="Bottom Left"/><ComboBoxItem Content="Bottom Center"/><ComboBoxItem Content="Bottom Right"/></ComboBox>
        </WrapPanel>
        <TextBlock Text="Opacity" Foreground="#FF9CA3AF" Margin="0,10,0,0"/>
        <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"/>
        <TextBlock Text="Floating bar quota indicators" Foreground="#FF9CA3AF" Margin="0,6,0,2"/>
        <WrapPanel><CheckBox x:Name="Show5H" Content="5 hour quota"/><CheckBox x:Name="ShowWeek" Content="Weekly quota" Margin="14,4,0,4"/></WrapPanel>
        <TextBlock Text="Quota percentage behavior" Foreground="#FF9CA3AF" Margin="0,7,0,4"/>
        <ComboBox x:Name="QuotaValueModePicker" Width="310" HorizontalAlignment="Left">
          <ComboBoxItem Content="Used · increases as quota is consumed" Tag="Used"/>
          <ComboBoxItem Content="Remaining · decreases as quota is consumed" Tag="Remaining"/>
        </ComboBox>
        <TextBlock Text="Session tokens and context details are shown in the dashboard." Foreground="#FF9CA3AF" FontSize="11" Margin="0,2,0,0"/>
        <Separator Margin="0,14" Background="#FF374151"/>
        <TextBlock Text="Warnings (%)" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,6"/>
        <WrapPanel>
          <StackPanel Margin="0,0,18,0"><TextBlock Text="Context" Foreground="#FF9CA3AF"/><TextBox x:Name="ContextThreshold" Width="80" Text="80"/></StackPanel>
          <StackPanel Margin="0,0,18,0"><TextBlock Text="Quota warning" Foreground="#FF9CA3AF"/><TextBox x:Name="QuotaThreshold" Width="80" Text="70"/></StackPanel>
          <StackPanel Margin="0,0,18,0"><TextBlock Text="Quota high" Foreground="#FF9CA3AF"/><TextBox x:Name="HighThreshold" Width="80" Text="85"/></StackPanel>
          <StackPanel><TextBlock Text="Critical" Foreground="#FF9CA3AF"/><TextBox x:Name="CriticalThreshold" Width="80" Text="95"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="Usage history remains on this PC and expires after 90 days." Foreground="#FF9CA3AF" FontSize="11" Margin="0,14,0,6"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
