<Window x:Class="CodexStatusBar.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Status Bar - Error Log" Height="560" Width="900"
        MinHeight="360" MinWidth="560" WindowStartupLocation="CenterScreen"
        Background="#111827" Foreground="#F3F4F6" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Error log" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="LogPathText" Margin="0,4,0,0" Foreground="#AAB6C8"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Padding="10"
                 Background="#0B1220" Foreground="#E5E7EB" BorderBrush="#374151" />

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#AAB6C8" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Copy Log" Click="Copy_Click" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Close" Click="Close_Click" Padding="12,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
