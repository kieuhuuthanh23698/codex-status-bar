<Window x:Class="CodexStatusBar.Views.StatusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove" Loaded="Window_Loaded">
  <Border x:Name="Root" CornerRadius="12" Background="#FF111827" BorderBrush="#FF59647A" BorderThickness="1"
          Padding="11,8" SnapsToDevicePixels="True" Cursor="Hand">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="CODEX" Foreground="#FFE9DDFF" FontWeight="Bold" FontSize="13" Margin="0,0,10,0"
                 TextOptions.TextFormattingMode="Display" VerticalAlignment="Center" />
      <TextBlock x:Name="MetricsText" Foreground="#FFFFFFFF" FontSize="14" FontWeight="Bold"
                 TextOptions.TextFormattingMode="Display" VerticalAlignment="Center" />
      <TextBlock x:Name="StateText" Foreground="#FFFF8585" FontSize="11" FontWeight="Bold" Margin="9,0,0,0"
                 TextOptions.TextFormattingMode="Display" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
