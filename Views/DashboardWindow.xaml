<Window x:Class="CodexStatusBar.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Status" Icon="/CodexStatusBar;component/Assets/CodexStatusBar.ico" Width="900" Height="700" MinWidth="760" MinHeight="600"
        Background="#FF111827" Foreground="#FFF3F4F6" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF3F4F6" /></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#FF293244"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF4B5563"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#FF293244"/><Setter Property="Foreground" Value="#FF111827"/><Setter Property="Padding" Value="5"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,15">
      <StackPanel>
        <TextBlock Text="Codex Status" FontSize="25" FontWeight="Bold"/>
        <TextBlock x:Name="UpdatedText" Foreground="#FF9CA3AF" Margin="0,4,0,0"/>
        <TextBlock x:Name="SelectedChatText" Foreground="#FFD1D5DB" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Daily Tokens" Click="DailyTokens_Click"/>
        <Button Content="Refresh Now" Click="Refresh_Click"/>
        <Button Content="Settings" Click="Settings_Click"/>
      </StackPanel>
    </DockPanel>
    <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,14">
      <Border Background="#FF1F2937" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="5 HOUR" Foreground="#FF9CA3AF" FontSize="11"/><TextBlock x:Name="FiveHourText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="FiveHourReset" Foreground="#FF9CA3AF" FontSize="11"/></StackPanel></Border>
      <Border Background="#FF1F2937" CornerRadius="10" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="WEEKLY" Foreground="#FF9CA3AF" FontSize="11"/><TextBlock x:Name="WeeklyText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="WeeklyReset" Foreground="#FF9CA3AF" FontSize="11"/></StackPanel></Border>
      <Border Background="#FF1F2937" CornerRadius="10" Padding="14" Margin="4,0"><StackPanel><TextBlock x:Name="InputTokensLabel" Text="CHAT INPUT" Foreground="#FF9CA3AF" FontSize="11"/><TextBlock x:Name="InputTokensText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Background="#FF1F2937" CornerRadius="10" Padding="14" Margin="4,0"><StackPanel><TextBlock x:Name="OutputTokensLabel" Text="CHAT OUTPUT" Foreground="#FF9CA3AF" FontSize="11"/><TextBlock x:Name="OutputTokensText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Background="#FF1F2937" CornerRadius="10" Padding="14" Margin="4,0"><StackPanel><TextBlock x:Name="ContextLabel" Text="CONTEXT USED" Foreground="#FF9CA3AF" FontSize="11"/><TextBlock x:Name="ContextText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="FreshnessText" Foreground="#FF9CA3AF" FontSize="11"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#FF1F2937" CornerRadius="10" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel Margin="3,0,0,8">
              <TextBlock Text="Codex chats" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="ChatCountText" DockPanel.Dock="Right" Foreground="#FF9CA3AF" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="ChatSearchBox" Height="32" Padding="8,5" Background="#FF111827" Foreground="#FFF3F4F6" BorderBrush="#FF4B5563" CaretBrush="White" ToolTip="Search chats by title, workspace, or ID" TextChanged="ChatSearch_TextChanged"/>
            <TextBlock Text="Ctrl/Shift-click to compare chats" Foreground="#FF9CA3AF" FontSize="10" Margin="3,6,0,0"/>
          </StackPanel>
          <ListBox x:Name="ChatsList" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Foreground="#FFF3F4F6" SelectionChanged="ChatsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ListSubtitle}" FontSize="10" Foreground="#FF9CA3AF" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="#FF1F2937" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Usage history" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="HistorySummary" Foreground="#FF9CA3AF" Margin="12,1,0,0"/>
          </StackPanel>
          <Canvas x:Name="ChartCanvas" Grid.Row="1" ClipToBounds="True"/>
          <TextBlock x:Name="HistoryCaption" Grid.Row="2" Text="Context usage over the last 30 days" Foreground="#FF9CA3AF" FontSize="11" Margin="0,8,0,0"/>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="StatusMessage" Foreground="#FF9CA3AF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Export CSV" Click="Export_Click"/>
        <Button Content="Close" Click="Close_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
